# Dev only (vite `serve`). Vite never loads this file for `vite build`, so none of
# it reaches a deployed bundle. It routes the SDK at a same-origin /api path that
# Vite proxies to the backend, because api.lemma.work does not send CORS headers
# for http://127.0.0.1:5173.
LEMMA_DEV_PROXY_TARGET="https://api.lemma.work"
VITE_LEMMA_API_URL="/api"
